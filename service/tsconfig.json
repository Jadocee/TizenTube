{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2018"],
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["*.ts", "types/*.d.ts"],
    "exclude": ["node_modules", "dist"]
}
