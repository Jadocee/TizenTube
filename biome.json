{
    "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**",
            "!**/dist",
            "!**/node_modules",
            "!**/*.generated.*",
            "!mods/spatial-navigation-polyfill.js",
            "!mods/tiny-sha256.js",
            "!test/tile-menu/fixtures.json",
            "!test/guide-filter/guide.json",
            "!test/**/old.html",
            "!test/stylesheet/page.template.html"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100,
        "lineEnding": "lf"
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "jsxQuoteStyle": "double",
            "trailingCommas": "all",
            "semicolons": "always",
            "arrowParentheses": "always",
            "bracketSpacing": true
        }
    },
    "json": {
        "formatter": {
            "trailingCommas": "none"
        }
    },
    "overrides": [
        {
            "includes": ["standalone/service/**", "service/**"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noPrototypeBuiltins": "off",
                        "noRedundantUseStrict": "off"
                    }
                }
            }
        },
        {
            "includes": ["**/package.json"],
            "json": {
                "formatter": {
                    "indentWidth": 2
                }
            }
        }
    ],
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "suspicious": {
                "noExplicitAny": "off",
                "noImplicitAnyLet": "off",
                "useIterableCallbackReturn": {
                    "level": "error",
                    "options": { "checkForEach": false }
                }
            },
            "style": {
                "noNonNullAssertion": "off"
            },
            "complexity": {
                "noArguments": "off",
                "noImportantStyles": "off",
                "useOptionalChain": "off"
            },
            "security": {
                "noGlobalEval": "off"
            },
            "a11y": {
                "useGenericFontNames": "off"
            }
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "off"
            }
        }
    }
}
